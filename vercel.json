{
    "version": 2,
    "regions": ["pdx1"],
    "crons": [
        {
            "path": "/api/accounts/closes/auto-run",
            "schedule": "59 4 * * *"
        },
        {
            "path": "/api/accounts/closes/auto-open",
            "schedule": "1 5 * * *"
        },
        {
            "path": "/api/holidays/sync",
            "schedule": "0 8 1 * *"
        }
    ],
    "builds": [
        {
            "src": "backend/src/server.ts",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/backend/src/server.ts"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/frontend/assets/$1"
        },
        {
            "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|webp))",
            "dest": "/frontend/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/index.html"
        }
    ]
}